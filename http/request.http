//== Client Requests ==

GET http://localhost:8080/api/clients
Accept: application/json

###

POST http://localhost:8080/api/clients
Content-type: application/json

{"name": "Michal", "age": 32}

> {%
 client.global.set("createdClientId", response.body.id);
 %}

###

GET http://localhost:8080/api/clients/{{createdClientId}}
Accept: application/json

###

PUT http://localhost:8080/api/clients/{{createdClientId}}
Content-type: application/json

{"name":  "Wojtek", "age":  52}

###

DELETE http://localhost:8080/api/clients/{{createdClientId}}

//== Car Requests

###

GET http://localhost:8080/api/clients/33333333-3333-3333-3333-333333333333/cars
Accept: application/json

###

POST http://localhost:8080/api/clients/{{createdClientId}}/cars
Content-type: application/json

{"model": "Corvette", "type":  "Coupe", "productionYear":  2023}

> {%
 client.global.set("createdCarId", response.body.id)
 %}

###

GET http://localhost:8080/api/clients/{{createdClientId}}/cars/{{createdCarId}}
Accept: application/json

###

PUT http://localhost:8080/api/clients/{{createdClientId}}/cars/{{createdCarId}}
Content-type: application/json

{"model": "Urus", "type":  "SUV", "productionYear":  2020}

###

DELETE http://localhost:8080/api/clients/{{createdClientId}}/cars/{{createdCarId}}

###